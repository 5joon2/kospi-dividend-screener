# 이 파일을 .streamlit/secrets.toml로 복사한 뒤 실제 값을 채워넣으세요.
# .streamlit/secrets.toml은 .gitignore에 포함되어 있어 커밋되지 않습니다.
# Streamlit Community Cloud에 배포할 때는 앱 설정의 Secrets 화면에 동일한 내용을 붙여넣으면 됩니다.

DART_API_KEY = "여기에_DART_인증키"
